{
  "name": "pr-review",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*\"",
    "fix": "eslint src/ --fix && prettier --write \"src/**/*\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "nock": "^14.0.15",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/string-similarity": "^4.0.2",
    "dotenv": "^17.2.3",
    "js-tiktoken": "^1.0.21",
    "minimatch": "^10.2.5",
    "openai": "^6.18.0",
    "p-limit": "^7.3.0",
    "parse-diff": "^0.11.1",
    "string-similarity": "^4.0.4",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
